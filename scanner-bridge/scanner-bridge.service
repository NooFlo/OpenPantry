# OpenPantry USB scanner bridge — Rock5 systemd unit
#
# This matches the unit already running on the Rock 5A (barcode-bridge.service).
# Install / update there:
#   sudo cp scanner_bridge.py /usr/local/bin/barcode-bridge.py
#   sudo cp scanner-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now barcode-bridge
#   journalctl -u barcode-bridge -f        # live scan log (also /var/log/barcode-bridge.log)

[Unit]
Description=USB Barcode Scanner bridge to OpenPantry
After=docker.service

[Service]
# The backend runs on the same host (docker port mapping 8321); override with
# Environment=PANTRY_URL=http://pantry.fritz.box:8321 if that ever changes.
ExecStart=/usr/bin/python3 /usr/local/bin/barcode-bridge.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
